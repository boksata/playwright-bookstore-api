{
  "name": "bookstore-api-ts",
  "version": "1.0.0",
  "description": "REST API test automation for Fake REST API using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:books": "playwright test tests/books",
    "test:authors": "playwright test tests/authors",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2"
  }
}
